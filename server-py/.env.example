# DeepSeek 对话模型
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-chat

# Embedding 模型（智谱 AI）
ZHIPU_API_KEY=YOUR_ZHIPU_API_KEY

# PostgreSQL（知识库向量检索 + 全链路追踪落库）
PG_HOST=postgres
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=jishu_ai_2025
PG_DATABASE=jisu_ai

# Redis（会话缓存，key = session:{session_id}）
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# 会话缓存 TTL：1800 秒 = 30 分钟，每次写入续期
SESSION_TTL_SECONDS=1800
# 单个会话保留的最大消息条数
SESSION_MAX_MESSAGES=20

# RAG 检索：Top-K 召回后用相似度阈值过滤低相关片段
# 实测参考：相关问题相似度 >=0.54，无关问题 <=0.30，0.4 卡在中间
RAG_TOP_K=4
RAG_SCORE_THRESHOLD=0.4

# 模型调用：超时（秒）/ 重试次数（不含第一次）/ 备用模型降级
MODEL_TIMEOUT_SECONDS=30
MODEL_STREAM_TIMEOUT_SECONDS=60
MODEL_MAX_RETRIES=2
# 备用模型：主模型超时/限流/5xx 时自动切过来；不填则不做降级
FALLBACK_MODEL_NAME=
FALLBACK_BASE_URL=
FALLBACK_API_KEY=
FALLBACK_TIMEOUT_SECONDS=30

# Embedding 调用：超时（秒）/ 重试次数
EMBEDDING_TIMEOUT_SECONDS=15
EMBEDDING_MAX_RETRIES=2

# 工具调用：超时（秒）/ 重试次数 / 重试间隔（秒）
TOOL_TIMEOUT_SECONDS=5
TOOL_MAX_RETRIES=2
TOOL_RETRY_BACKOFF_SECONDS=0.3

# Token 用量统计保留时间（秒），默认 7 天
USAGE_RETENTION_SECONDS=604800

# ── 用户身份 / 权限（app/security/identity.py）──────────────────
# 登录令牌（HMAC-SHA256）的签名密钥：**生产必须配置**，且要足够长、随机。
# 不配置时会退化成"每个进程随机生成"——容器里 uvicorn 是 --workers 2，
# 两个进程密钥不同 → A 进程签发的令牌在 B 进程验签失败（表现为用户"登录态莫名失效"）。
# 改了这个值，所有已登录的令牌立即失效（前端会自动用原身份重新登录）。
IDENTITY_SECRET=change-me-to-a-long-random-string
# 令牌有效期（秒），默认 43200 = 12 小时
IDENTITY_TTL_SECONDS=43200

# 管理员后台（前端左上角「管理员入口」）
# false = 免登录，点开直接进；true = 需要下面的账号密码
ADMIN_AUTH_ENABLED=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456
# 登录令牌有效期（秒），默认 8 小时
ADMIN_TOKEN_TTL=28800
# 登录失败限制：5 分钟内最多失败 5 次
ADMIN_LOGIN_MAX_FAILURES=5
ADMIN_LOGIN_WINDOW_SECONDS=300

# ── 全链路追踪（app/observability/trace.py，落 PostgreSQL）──────
# 一次请求 = 一条 run（trace_runs），请求里每个环节 = 一条 step（trace_steps），
# 管理后台「链路追踪」页签按时间线展开，每一步的入参出参都能点开看。
# 关掉后所有埋点变成空操作（零成本），后台该页签会显示"没有记录"
TRACE_ENABLED=true
# 单个字符串字段（回答 / 提示词 / 命中片段）的字符上限
TRACE_MAX_STR=2000
# 单步 detail 序列化后的字节上限，超了只留预览
TRACE_MAX_DETAIL=16000
# 单个 run 最多记多少步（跑飞的循环不至于把库撑爆）
TRACE_MAX_STEPS=300
# 追踪保留天数（超期的在写入时顺手清掉）
TRACE_RETENTION_DAYS=7
# 单次请求最多记多少次模型调用 + 提示词预览截断长度
TRACE_MAX_LLM_CALLS=20
TRACE_PROMPT_PREVIEW_CHARS=400

# 对话记录（聊天审计）保留时间（秒），默认 7 天
CHATLOG_RETENTION_SECONDS=604800
# 后台单次查询最多扫描的记录条数
CHATLOG_SCAN_LIMIT=2000
# 单轮记录里问答文本 / 检索片段的最大长度与条数
CHATLOG_MAX_TEXT_CHARS=4000
CHATLOG_MAX_RETRIEVAL_HITS=10

# 日志级别
LOG_LEVEL=INFO
# ── 提示词安全防护（独立模块 app/security）────────────────────
SECURITY_ENABLED=true
# 判定用小模型（便宜、快）：glm-4-air；也可换 glm-4-flash
SECURITY_MODEL=glm-4-air
# 安全模块专用 Key，留空则回退到 ZHIPU_API_KEY
SECURITY_ZHIPU_API_KEY=YOUR_ZHIPU_API_KEY
SECURITY_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 小模型超时（秒）与失败策略：open=放行并记日志 / closed=拦截
SECURITY_TIMEOUT_SECONDS=3
SECURITY_FAIL_MODE=open
SECURITY_MAX_INPUT_CHARS=2000
SECURITY_WHITELIST_ENABLED=true
# 历史里有可疑输入时的策略：escalate=不连坐、升级给小模型再判一次（默认）/ ignore=只看当前这条
SECURITY_CACHE_TTL=86400
SECURITY_HISTORY_POLICY=escalate
# ── 熔断（app/resilience/circuit.py）──────────────────────────
# 下游整体故障时不再"傻等超时"：失败到阈值就快速失败、走各自降级，过一会儿自动试探恢复
# 覆盖的下游：llm:chat（主模型）/ llm:chat:fallback / embedding:zhipu /
#             judge:security（安全判定）/ judge:handoff（退款判定）/ cache:redis
CIRCUIT_ENABLED=true
# 影子模式：只统计不拦（先观察真实失败率，再决定要不要真的跳闸）
CIRCUIT_DRY_RUN=false
CIRCUIT_WINDOW_SECONDS=60          # 统计窗口
CIRCUIT_MIN_REQUESTS=10            # 窗口内至少这么多次请求才允许跳闸（防止低流量误判）
CIRCUIT_FAILURE_RATE=0.5           # 失败率阈值
CIRCUIT_CONSECUTIVE_FAILURES=5     # 连续失败这么多次也跳闸
CIRCUIT_OPEN_SECONDS=30            # 首次冷却；之后每失败一次翻倍
CIRCUIT_BACKOFF_MAX_SECONDS=300    # 冷却上限
CIRCUIT_HALF_OPEN_PROBES=3         # 半开时连续探测成功几次算恢复
CIRCUIT_JITTER=0.2                 # 冷却抖动，避免同时恢复
# 单个依赖可覆盖，例如：CIRCUIT_EMBEDDING_OPEN_SECONDS=60 / CIRCUIT_ZHIPU_OPEN_SECONDS=60
# Redis 快失败：默认重试策略在 Redis 挂掉时单次操作要等十几秒（实测 14.6s），这里关掉重试
REDIS_CONNECT_TIMEOUT=1.0
REDIS_SOCKET_TIMEOUT=2.0

# ── 退款族意图判定（app/utils/handoff.py）─────────────────────
# 判定"是要办退款"还是"只是咨询"：规则快路径（0 token）→ 小模型 → 失败 fail-open 走正常链路
# 关掉则一律走正常链路（不拦、不堵）：HANDOFF_JUDGE_ENABLED=false
HANDOFF_JUDGE_ENABLED=true
# 判定用小模型：glm-4-air（实测 40 条样本 100% 准确，小模型 737ms/次，结果缓存 24h）
HANDOFF_MODEL=glm-4-air
HANDOFF_ZHIPU_API_KEY=YOUR_ZHIPU_API_KEY
HANDOFF_TIMEOUT_SECONDS=3
HANDOFF_CACHE_TTL=86400

# ── 检索增强（可选）────────────────────────────────────────────
# 关键词召回 + RRF 融合默认开启（零成本，无需配置）
# 重排用硅基流动 SiliconFlow 的 BAAI/bge-reranker-v2-m3（Cross-Encoder 精排）：
#   · 分数可区分（实测同一问句 0.8263 / 0.0837 / 0.0008），不像智谱 rerank 那样全是 0.999+
#   · 一次约 0.3s、百来 token；候选不足 RAG_RERANK_MIN_CANDIDATES 时不发请求
#   · 接口失败一律 fail-open：保持原顺序，不影响回答
RAG_RERANK_ENABLED=false        # 数据量小不需要；知识库变大（几百片段以上）再开
RAG_RERANK_BASE_URL=https://api.siliconflow.cn/v1
RAG_RERANK_API_KEY=YOUR_SILICONFLOW_API_KEY
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANK_TOP_N=4
RAG_RERANK_MIN_CANDIDATES=2
RAG_RERANK_TIMEOUT_SECONDS=3
